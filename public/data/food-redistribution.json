{"type": "FeatureCollection", "features": [{"type": "Feature", "geometry": {"coordinates": [-97.743484, 30.291125], "type": "Point"}, "properties": {"name": "26 West Apartment Complex - West Campus Collective Site", "description": "<div style=\"text-align: center; margin-bottom: 10px;\">\n  <a href=\"https://rebrand.ly/hl71vlu\" target=\"_blank\"\n     style=\"background-color: LightGray; color: white; padding: 8px 40px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-align: center;\">\n\n      <span style=\"font-size: 1.2em; position: relative; top: 1px;\">\ud83d\ude8d</span>\n\n      <span>Learn More</span>\n  </a>\n</div>Student-led initiative dedicated to addressing food insecurity and reducing food waste in the West Campus area. \n\nCollaborates with various student groups to redistribute surplus meals to economically disadvantaged students. These distributions typically occur at 26 West and the ATX Free Fridge on Pearl Street. ", "Address": "600 W 26th St, Austin, TX 78705", "Contact": "Instagram: @westcampuscollective Email: westcampuscollective@gmail.com", "Eligibility": "N/A", "Hours": "Text @wcc-2 to 81010 for text reminders on when and where distributions are since the schedule will look slightly different every week.", "Last Updated": "5/4/25"}, "id": "QzNjQ"}, {"type": "Feature", "geometry": {"type": "Point", "coordinates": [-97.748735, 30.247365]}, "properties": {"osm_type": "N", "osm_id": 3866334112, "osm_key": "place", "osm_value": "house", "type": "house", "postcode": "78704", "housenumber": "205", "countrycode": "US", "country": "United States", "city": "Austin", "locality": "South River City", "street": "East Monroe Street", "state": "Texas", "county": "Travis County", "name": "Austin Bicycle Meals ", "description": "Austin Bicycle Meals distributes hot food and other vital supplies in Downtown/East Austin area via bicycle.\n", "Address": "205 E Monroe St, Austin, TX 78704", "Contact": "Instagram: @austinbicyclemeals ", "Eligibility": "Anyone!", "Hours": "Saturday @ 2pm, Every other Wednesday @ 5:30pm", "Last Updated": "06/21/2025", "Website": "https://linktr.ee/austinbicyclemeals?fbclid=PAZXh0bgNhZW0CMTEAAaeG4v5go9og4iRMRSAzvKqKQJztJyAbdm8Yh9xCDMIOUX41b1Lk1_NIoaN0EA_aem_UePVx3ljdc3nXPs1FGK3Bw"}, "id": "A5NzE"}, {"type": "Feature", "geometry": {"coordinates": [-97.746842, 30.28425], "type": "Point"}, "properties": {"name": "West Campus Fridge - ATX Free Fridge Project", "description": "<div style=\"text-align: center; margin-bottom: 10px;\">\n  <a href=\"https://rebrand.ly/g0jwu4q?api=1&destination=30.284155675275233, -97.74716646249155&travelmode=walking\" target=\"_blank\"\n     style=\"background-color: LightGray; color: white; padding: 8px 40px; text-decoration: none; border-radius: 8px; font-weight: bold; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-align: center;\">\n\n      <span style=\"font-size: 1.2em; position: relative; top: 1px;\">\ud83d\ude8d</span>\n\n      <span>Learn More</span>\n  </a>\n</div>Community refrigerator.\n\nPart of the ATX Free Fridge Project, a mutual aid organization dedicated to fighting food insecurity and reducing food waste. Take what you need or leave any surplus food you\u2019d like to share. \n\nThe West Campus Fridge is a West Campus Collective site as well!", "Address": "2000 Pearl St, Austin, TX 78705", "Contact": "Instagram: @atxfreefridge, Email: atxfreefridge@gmail.com", "Eligibility": "No eligibility requirements.", "Hours": "N/A", "Last Updated": "2/23/25", "Website": "https://www.atxfreefridge.com/?fbclid=PAZXh0bgNhZW0CMTEAAabGZZjfVOsiLxnypm5PtxpwEH8RSM1UIAKVfu0GQuG7KDxeCipWdF1hvmE_aem_qMkLzrcWA29fGfTeXQcWWA", "Learn more": "https://rebrand.ly/0kq43xa"}, "id": "g1NDU"}], "_umap_options": {"displayOnLoad": true, "inCaption": true, "browsable": true, "editMode": "advanced", "id": "53530a60-3761-4221-819f-dcf601d2eac1", "name": "Food Redistribution Points", "rank": 2, "color": "LightGray", "fields": [{"key": "name", "type": "String"}, {"key": "description", "type": "String"}, {"key": "Address", "type": "String"}, {"key": "Contact", "type": "String"}, {"key": "Eligibility", "type": "String"}, {"key": "Hours", "type": "String"}, {"key": "Last Updated", "type": "String"}, {"key": "osm_type", "type": "String"}, {"key": "osm_id", "type": "String"}, {"key": "osm_key", "type": "String"}, {"key": "osm_value", "type": "String"}, {"key": "type", "type": "String"}, {"key": "postcode", "type": "String"}, {"key": "housenumber", "type": "String"}, {"key": "countrycode", "type": "String"}, {"key": "country", "type": "String"}, {"key": "city", "type": "String"}, {"key": "locality", "type": "String"}, {"key": "street", "type": "String"}, {"key": "state", "type": "String"}, {"key": "county", "type": "String"}, {"key": "Website", "type": "String"}, {"key": "Learn more", "type": "String"}], "iconUrl": "/uploads/pictogram/basic-hut.svg", "remoteData": {}, "description": "\nThese are publicly accessible food distribution sites that help combat food insecurity and reduce food waste. They include locations from the ATX Free Fridge network, which provides free, 24/7 access to donated food across Austin. Additionally, the West Campus Collective Free Fridge is tailored specifically for UT Austin students and nearby residents, offering surplus food from campus events \u2014 all with no ID, cost, or eligibility requirements.", "popupContentTemplate": "# {name}\n\n{description}\n\n**Hours:** {Hours}", "permissions": {"edit_status": 2}}}
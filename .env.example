# Copy these into your hosting provider's environment variables (e.g. Vercel > Settings > Environment Variables)
# or into a local .env.local file. Tracking only loads when these are set.

# Optional: Google Analytics 4 Measurement ID. Defaults to G-CTP1RW2VFY (set in src/components/Analytics.tsx).
# NEXT_PUBLIC_GA_ID=

# Microsoft Clarity Project ID (clarity.microsoft.com > Settings > Overview), looks like abc123xyz9
NEXT_PUBLIC_CLARITY_ID=
